+// Isolated nuwa checkpoint only. No hardware access has been authorized.
+extern "C" {
+extern kmod_info_t g_kernel_kmod_info;
+kern_return_t OSKextLoadKextWithIdentifier(const char *);
+void nuwa_ufs_static_init(void) __asm__("__GLOBAL__sub_I_NativeUfs.cpp");
+volatile unsigned nuwa_ufs_init_state;
+volatile unsigned nuwa_ufs_attempt, nuwa_ufs_completed, nuwa_ufs_hc_read;
+volatile uint32_t nuwa_ufs_raw[14];
+volatile unsigned nuwa_ufs_terminal;
+}
+
+// Called once on the bootstrap thread, before root registerService(). The
+// late-object transform removes auto-init; no worker/lock/transport is added.
+extern "C" void nuwa_ufs_handoff_init(void)
+{
+  unsigned probe = 0, root = 0;
+  PE_parse_boot_argn("native-ufs-probe", &probe, sizeof(probe));
+  PE_parse_boot_argn("native-ufs-root", &root, sizeof(root));
+  if (probe != 2 || root || nuwa_ufs_init_state) return;
+  nuwa_ufs_init_state = 1;
+  if (OSKextLoadKextWithIdentifier("com.apple.iokit.IOStorageFamily")) {
+    nuwa_ufs_init_state = 2;
+    return;
+  }
+  void *handle = OSMetaClass::preModLoad(g_kernel_kmod_info.name);
+  if (!handle) { nuwa_ufs_init_state = 3; OSMetaClass::postModLoad(handle); return; }
+  nuwa_ufs_static_init();
+  if (OSMetaClass::postModLoad(handle)) { nuwa_ufs_init_state = 4; return; }
+  nuwa_ufs_init_state = 5;
+}
