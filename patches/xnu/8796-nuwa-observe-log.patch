+#define NUWA_LINES     14
+#define NUWA_COLS      72
+#define NUWA_SCALE     3
+#define NUWA_CELL      (6 * NUWA_SCALE)
+#define NUWA_ROWH      (14 * NUWA_SCALE)
+
+static char nuwa_line[NUWA_LINES][NUWA_COLS];
+static unsigned int nuwa_line_next;
+static boolean_t nuwa_observe_painted[16];
+static unsigned int nuwa_exit_count;
+
+static void
+nuwa_paint_line(unsigned int slot)
+{
+	const struct vc_info *v = &vinfo;
+	unsigned int y0, x, gy, gx, dy, dx, i, bpp4, ch;
+	unsigned int *fb;
+	unsigned long long glyph, data;
+
+	if (v->v_baseaddr == 0 || v->v_rowbytes == 0 || v->v_width == 0 || v->v_height == 0) {
+		return;
+	}
+	y0 = v->v_height / 2 + slot * NUWA_ROWH;
+	if (y0 + NUWA_ROWH > v->v_height) {
+		return;
+	}
+	bpp4 = v->v_rowbytes / 4;
+	fb = (unsigned int *)v->v_baseaddr;
+	for (gy = 0; gy < NUWA_ROWH; gy++) {
+		for (gx = 0; gx < bpp4; gx++) {
+			fb[(y0 + gy) * bpp4 + gx] = 0;
+		}
+	}
+	for (i = 0; i < NUWA_COLS - 1 && nuwa_line[slot][i] != 0; i++) {
+		ch = (unsigned char)nuwa_line[slot][i];
+		if (ch < 32 || ch > 126) {
+			continue;
+		}
+		glyph = nuwa_font[ch - 32];
+		x = i * NUWA_CELL;
+		for (gy = 0; gy < 12; gy++) {
+			data = (gy < 6) ? ((glyph >> 32) >> (gy * 5))
+			    : ((glyph & 0xFFFFFFFFULL) >> ((gy - 6) * 5));
+			for (gx = 0; gx < 5; gx++) {
+				if (((data >> gx) & 1) == 0) {
+					continue;
+				}
+				for (dy = 0; dy < NUWA_SCALE; dy++) {
+					for (dx = 0; dx < NUWA_SCALE; dx++) {
+						fb[(y0 + gy * NUWA_SCALE + dy) * bpp4 + x + gx * NUWA_SCALE + dx] =
+						    0xFFFFFFFFu;
+					}
+				}
+			}
+		}
+	}
+}
+
+static char *
+nuwa_str(char *p, const char *s)
+{
+	while (*s != 0 && (p - nuwa_line[0]) < (long)sizeof(nuwa_line)) {
+		*p++ = *s++;
+	}
+	return p;
+}
+
+static char *
+nuwa_num(char *p, unsigned long v)
+{
+	char t[12];
+	int n = 0;
+
+	if (v == 0) {
+		*p++ = '0';
+		return p;
+	}
+	while (v != 0) {
+		t[n++] = (char)('0' + (v % 10));
+		v /= 10;
+	}
+	while (n > 0) {
+		*p++ = t[--n];
+	}
+	return p;
+}
+
+static char *
+nuwa_name(char *p, const char *name)
+{
+	int n = 0;
+
+	while (name != NULL && name[n] != 0 && n < 16) {
+		*p++ = name[n++];
+	}
+	return p;
+}
+
+static char *
+nuwa_begin(void)
+{
+	unsigned int slot = nuwa_line_next % NUWA_LINES;
+	char *p = nuwa_line[slot];
+
+	nuwa_line_next++;
+	p[0] = 0;
+	return p;
+}
+
+static void
+nuwa_end(char *p)
+{
+	unsigned int slot = (nuwa_line_next - 1) % NUWA_LINES;
+	*p = 0;
+	nuwa_paint_line(slot);
+}
+
+void
+nuwa_observe_band(unsigned int band, unsigned int pixel)
+{
+	uint64_t total, chunk, off, i, pattern;
+	volatile uint64_t *q;
+
+	if (band >= 16 || nuwa_observe_painted[band]) {
+		return;
+	}
+	if (vinfo.v_baseaddr == 0 || vinfo.v_rowbytes == 0 || vinfo.v_height == 0) {
+		return;
+	}
+	nuwa_observe_painted[band] = TRUE;
+	total = (uint64_t)vinfo.v_rowbytes * (uint64_t)vinfo.v_height;
+	chunk = (total / 16) & ~7ULL;
+	if (chunk == 0) {
+		return;
+	}
+	off = chunk * band;
+	pattern = ((uint64_t)pixel << 32) | (uint64_t)pixel;
+	q = (volatile uint64_t *)(vinfo.v_baseaddr + off);
+	for (i = 0; i < chunk; i += 8) {
+		*q++ = pattern;
+	}
+}
+
+void
+nuwa_observe_exec(int ok, int err, int pid, const char *name)
+{
+	char *p = nuwa_begin();
+
+	p = nuwa_str(p, ok ? "EXEC ok  pid " : "EXEC err ");
+	if (!ok) {
+		p = nuwa_num(p, (unsigned long)err);
+		p = nuwa_str(p, " pid ");
+	}
+	p = nuwa_num(p, (unsigned long)pid);
+	p = nuwa_str(p, " ");
+	p = nuwa_name(p, name);
+	nuwa_end(p);
+}
+
+void
+nuwa_observe_reject(int code, int pid, const char *name)
+{
+	char *p = nuwa_begin();
+
+	p = nuwa_str(p, "AMFI rej c=");
+	p = nuwa_num(p, (unsigned long)code);
+	p = nuwa_str(p, " pid ");
+	p = nuwa_num(p, (unsigned long)pid);
+	p = nuwa_str(p, " ");
+	p = nuwa_name(p, name);
+	nuwa_end(p);
+}
+
+void
+nuwa_observe_launchc(int code, int pid, const char *name)
+{
+	char *p = nuwa_begin();
+
+	p = nuwa_str(p, "LCHAIN e=");
+	p = nuwa_num(p, (unsigned long)code);
+	p = nuwa_str(p, " pid ");
+	p = nuwa_num(p, (unsigned long)pid);
+	p = nuwa_str(p, " ");
+	p = nuwa_name(p, name);
+	nuwa_end(p);
+}
+
+void
+nuwa_observe_syscall(int code)
+{
+	char *p = nuwa_begin();
+
+	p = nuwa_str(p, "SYS ");
+	p = nuwa_num(p, (unsigned long)code);
+	nuwa_end(p);
+}
+
+void
+nuwa_observe_exit(int pid, int rv, const char *name)
+{
+	char *p;
+
+	if (nuwa_exit_count >= 20) {
+		return;
+	}
+	nuwa_exit_count++;
+	p = nuwa_begin();
+	p = nuwa_str(p, "EXIT pid ");
+	p = nuwa_num(p, (unsigned long)pid);
+	p = nuwa_str(p, " rv ");
+	p = nuwa_num(p, (unsigned long)(rv & 0xFFFF));
+	p = nuwa_str(p, " ");
+	p = nuwa_name(p, name);
+	nuwa_end(p);
+}
