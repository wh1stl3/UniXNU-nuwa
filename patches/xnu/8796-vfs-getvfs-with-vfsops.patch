+ *  @param fsid Filesystem ID to look up.
+ *  @param ops Required vfsops pointer.
+ *  @return Matching mount, including one being unmounted, or NULL. No owning reference is acquired.
+ */
+mount_t vfs_getvfs_with_vfsops(fsid_t *fsid, const struct vfsops * const ops);
