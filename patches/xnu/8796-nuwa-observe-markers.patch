 volatile int nuwa_exec_policy_error;
 #endif /* XNU_NUWA_EXEC_POLICY_SKIP */
 
+#if XNU_NUWA_OBSERVE
+#include <console/video_console.h>
+
+extern struct vc_info vinfo;
+
+/*
+ * nuwa observation only (XNU_NUWA_OBSERVE): paint one 1/16 band of the live
+ * frame buffer through the kernel mapping vinfo.v_baseaddr. Bands 1 and 2 are
+ * the build's MMU-off / MMU-on entry markers (blue, magenta); band 3 (cyan,
+ * rows 3/16..4/16) and band 15 (orange, last 1/16) are free and touch neither
+ * those bands nor the loader's text block that starts at 1/4 of the screen.
+ * Stores only: no lock, no allocation, no sleep. Each band is painted once.
+ */
+static boolean_t nuwa_observe_painted[16];
+
+void
+nuwa_observe_band(unsigned int band, unsigned int pixel)
+{
+	uint64_t total, chunk, off, i, pattern;
+	volatile uint64_t *p;
+
+	if (band >= 16 || nuwa_observe_painted[band]) {
+		return;
+	}
+	if (vinfo.v_baseaddr == 0 || vinfo.v_rowbytes == 0 || vinfo.v_height == 0) {
+		return;
+	}
+	nuwa_observe_painted[band] = TRUE;
+	total = (uint64_t)vinfo.v_rowbytes * (uint64_t)vinfo.v_height;
+	chunk = (total / 16) & ~7ULL;
+	if (chunk == 0) {
+		return;
+	}
+	off = chunk * band;
+	pattern = ((uint64_t)pixel << 32) | (uint64_t)pixel;
+	p = (volatile uint64_t *)(vinfo.v_baseaddr + off);
+	for (i = 0; i < chunk; i += 8) {
+		*p++ = pattern;
+	}
+}
+#endif /* XNU_NUWA_OBSERVE */
+
