From: UniXNU upstream
Subject: [PATCH] 8796-native-text-fixup (official signed-text fixup mechanism)

Port of UniXNU/patches/xnu/native-text-fixup.patch into the nuwa 8796 series.
The upstream file is unmodified except for this preamble and one parser
hardening hunk marked below; the mechanism itself is the official one
(signature page validated, then "vnode name + file offset + original bytes"
matched and replaced through the physical page alias, followed by
cache_sync_page()). The table comes from /chosen/text-fixups (NUL-separated
entries), written by scripts/make-nuwa-adt.py --text-fixup.

Deviation from upstream (parser only, requested by review):
  cs_text_fixup_init() rejected the last entry only implicitly. If the
  property ends without a NUL, strnlen() returns the remaining length and the
  entry is copied and parsed as if terminated. The hunk now checks
  "s + length == end" first and ignores that unterminated tail entry (printf
  "unterminated, ignored"), leaving every earlier entry unchanged.
  This is not a mechanism change: no fixup that parsed before is dropped.

8796 context differences (hunk headers only; no context or semantic change):
  bsd/kern/ubc_subr.c   upstream @@ -6043,6 +6043,172 @@ cs_validate_hash
                        -> 8796 applies at 5830 (offset -213) before
                        cs_validate_range at 5834. On the r35 4K-hash-cache
                        translation unit (out/nuwa-r35-20261119/tree) the same
                        hunk lands at 6010 (offset -33).
  osfmk/vm/vm_fault.c   upstream hunk 1 @@ -100,6 +100,9 @@ (the include block
                        after <vm/vm_shared_region.h>) applies unchanged at 102;
                        hunk 2 @@ -7797,6 +7800,14 @@ applies at 7562
                        (offset -238) inside vm_page_validate_cs_mapped_slow
                        (8796 body 7515..7570, after page->vmp_cs_nx).
  osfmk/vm/vm_protos.h  upstream @@ -539,6 +539,7 @@ -> 8796 applies at 529
                        (offset -10) after cs_validate_range's declaration.
8796 notes:
  - validated/tainted are the int bit masks cs_validate_page() fills; the
    VMP_CS_ALL_TRUE/VMP_CS_ALL_FALSE comparison is identical to upstream.
  - TUNABLE_STR/STARTUP and os_atomic_inc resolve through ubc_subr.c's existing
    includes; phystokv and the <arm/caches_internal.h> cache_sync_page() the
    patch adds are already reachable in vm_fault.c.
  - An empty table leaves cs_text_fixup_page() returning 0, so this hook
    changes no page bytes and does not call cache_sync_page(). It does not make
    the image equivalent to an unpatched build: the patched TU, early-boot
    parsing, exported symbols and the banner's TF=0/0 are all still present.

Apply with -p1 in the XNU tree root.
---
diff --git a/bsd/kern/ubc_subr.c b/bsd/kern/ubc_subr.c
index 22c5bf1..05c6504 100644
--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -6043,6 +6043,177 @@ cs_validate_hash(
 	return validated;
 }
 
+/*
+ * Fixups of signed file text, each <file name>,<file offset>,<original>,<replacement> (offset in hex, byte strings in hex, at
+ * most 16 bytes): the board's table in the device tree (/chosen/text-fixups, NUL-separated entries, so it takes no command line
+ * space), then the boot arguments text-fixup0..7. A page is changed only after it passed signature validation and only when
+ * the original bytes match, so a different file or build is left alone.
+ */
+#include <pexpert/device_tree.h>
+#define CS_TEXT_FIXUP_MAX 32
+#define CS_TEXT_FIXUP_BYTES 16
+struct cs_text_fixup {
+	char            name[64];
+	uint64_t        offset;
+	uint8_t         original[CS_TEXT_FIXUP_BYTES];
+	uint8_t         replacement[CS_TEXT_FIXUP_BYTES];
+	uint32_t        length;
+};
+static TUNABLE_STR(cs_text_fixup_arg0, 160, "text-fixup0", "");
+static TUNABLE_STR(cs_text_fixup_arg1, 160, "text-fixup1", "");
+static TUNABLE_STR(cs_text_fixup_arg2, 160, "text-fixup2", "");
+static TUNABLE_STR(cs_text_fixup_arg3, 160, "text-fixup3", "");
+static TUNABLE_STR(cs_text_fixup_arg4, 160, "text-fixup4", "");
+static TUNABLE_STR(cs_text_fixup_arg5, 160, "text-fixup5", "");
+static TUNABLE_STR(cs_text_fixup_arg6, 160, "text-fixup6", "");
+static TUNABLE_STR(cs_text_fixup_arg7, 160, "text-fixup7", "");
+static struct cs_text_fixup cs_text_fixups[CS_TEXT_FIXUP_MAX];
+static uint32_t cs_text_fixup_count;
+uint32_t cs_text_fixup_parsed;
+uint32_t cs_text_fixup_applied;
+
+static int
+cs_text_fixup_hex(char c)
+{
+	if (c >= '0' && c <= '9') {
+		return c - '0';
+	}
+	if (c >= 'a' && c <= 'f') {
+		return c - 'a' + 10;
+	}
+	if (c >= 'A' && c <= 'F') {
+		return c - 'A' + 10;
+	}
+	return -1;
+}
+
+/* Hex bytes up to the next ',' or the end; returns the count or 0 on a malformed field. */
+static uint32_t
+cs_text_fixup_bytes(const char **cursor, uint8_t *out)
+{
+	const char *s = *cursor;
+	uint32_t n = 0;
+	while (*s && *s != ',') {
+		int hi = cs_text_fixup_hex(s[0]), lo = s[1] ? cs_text_fixup_hex(s[1]) : -1;
+		if (hi < 0 || lo < 0 || n == CS_TEXT_FIXUP_BYTES) {
+			return 0;
+		}
+		out[n++] = (uint8_t)(hi << 4 | lo);
+		s += 2;
+	}
+	*cursor = *s ? s + 1 : s;
+	return n;
+}
+
+static bool
+cs_text_fixup_parse(const char *arg, struct cs_text_fixup *f)
+{
+	const char *comma = strchr(arg, ',');
+	if (comma == NULL || comma == arg || (size_t)(comma - arg) >= sizeof(f->name)) {
+		return false;
+	}
+	strlcpy(f->name, arg, (size_t)(comma - arg) + 1);
+	const char *s = comma + 1;
+	f->offset = 0;
+	for (; *s && *s != ','; s++) {
+		int v = cs_text_fixup_hex(*s);
+		if (v < 0) {
+			return false;
+		}
+		f->offset = f->offset << 4 | (uint64_t)v;
+	}
+	if (*s++ != ',') {
+		return false;
+	}
+	uint32_t n = cs_text_fixup_bytes(&s, f->original);
+	if (n == 0 || cs_text_fixup_bytes(&s, f->replacement) != n || *s) {
+		return false;
+	}
+	/* One page holds the whole fixup, so a single validated page carries it. */
+	if ((f->offset & PAGE_MASK) + n > PAGE_SIZE) {
+		return false;
+	}
+	f->length = n;
+	return true;
+}
+
+static void
+cs_text_fixup_init(void)
+{
+	DTEntry chosen;
+	void const *table;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+	    SecureDTGetProperty(chosen, "text-fixups", &table, &size) == kSuccess) {
+		const char *s = table, *end = s + size;
+		for (int i = 0; s < end && *s; i++) {
+			char entry[160];
+			/* A property that ends without NUL leaves the last entry unterminated: reject it. */
+			size_t length = strnlen(s, (size_t)(end - s));
+			if (s + length == end) {
+				printf("text-fixups[%d]: unterminated, ignored\n", i);
+				break;
+			}
+			if (length < sizeof(entry) && cs_text_fixup_count < CS_TEXT_FIXUP_MAX) {
+				strlcpy(entry, s, length + 1);
+				if (cs_text_fixup_parse(entry, &cs_text_fixups[cs_text_fixup_count])) {
+					cs_text_fixup_count++;
+				} else {
+					printf("text-fixups[%d]: malformed, ignored\n", i);
+				}
+			} else {
+				printf("text-fixups[%d]: too long or table full, ignored\n", i);
+			}
+			s += length + 1;
+		}
+	}
+	const char *args[] = {
+		cs_text_fixup_arg0, cs_text_fixup_arg1, cs_text_fixup_arg2, cs_text_fixup_arg3,
+		cs_text_fixup_arg4, cs_text_fixup_arg5, cs_text_fixup_arg6, cs_text_fixup_arg7,
+	};
+	for (int i = 0; i < (int)(sizeof(args) / sizeof(args[0])); i++) {
+		if (args[i][0] == '\0' || cs_text_fixup_count == CS_TEXT_FIXUP_MAX) {
+			continue;
+		}
+		if (cs_text_fixup_parse(args[i], &cs_text_fixups[cs_text_fixup_count])) {
+			cs_text_fixup_count++;
+		} else {
+			printf("text-fixup%d: malformed, ignored\n", i);
+		}
+	}
+	cs_text_fixup_parsed = cs_text_fixup_count;
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, cs_text_fixup_init);
+
+/*
+ * Applies the fixups that fall in this validated page of vp. kva is a writable kernel address of the page. Returns the
+ * number of fixups written, so the caller makes the instruction cache coherent.
+ */
+uint32_t
+cs_text_fixup_page(struct vnode *vp, memory_object_offset_t page_offset, void *kva)
+{
+	uint32_t written = 0;
+	for (uint32_t i = 0; i < cs_text_fixup_count; i++) {
+		const struct cs_text_fixup *f = &cs_text_fixups[i];
+		if (f->offset < page_offset || f->offset + f->length > page_offset + PAGE_SIZE) {
+			continue;
+		}
+		if (vp == NULLVP || vp->v_name == NULL || strcmp(vp->v_name, f->name) != 0) {
+			continue;
+		}
+		uint8_t *at = (uint8_t *)kva + (f->offset - page_offset);
+		if (memcmp(at, f->original, f->length) != 0) {
+			continue;
+		}
+		memcpy(at, f->replacement, f->length);
+		written++;
+		if (os_atomic_inc(&cs_text_fixup_applied, relaxed) <= 16) {
+			printf("text-fixup: %s+0x%llx (%u bytes) applied\n", f->name, f->offset, f->length);
+		}
+	}
+	return written;
+}
+
 boolean_t
 cs_validate_range(
 	struct vnode    *vp,
diff --git a/osfmk/vm/vm_fault.c b/osfmk/vm/vm_fault.c
index 5184390..5bf9f03 100644
--- a/osfmk/vm/vm_fault.c
+++ b/osfmk/vm/vm_fault.c
@@ -100,6 +100,9 @@
 #include <vm/memory_object.h>
 #include <vm/vm_purgeable_internal.h>   /* Needed by some vm_page.h macros */
 #include <vm/vm_shared_region.h>
+#if __arm64__
+#include <arm/caches_internal.h>
+#endif
 
 #include <sys/codesign.h>
 #include <sys/code_signing.h>
@@ -7797,6 +7800,14 @@ vm_page_validate_cs_mapped_slow(
 	page->vmp_cs_tainted |= tainted;
 	page->vmp_cs_nx |= nx;
 
+#if __arm64__
+	/* Boot-argument fixups of signed text land after validation, through the physical aperture, before any mapping. */
+	if (validated == VMP_CS_ALL_TRUE && tainted == VMP_CS_ALL_FALSE &&
+	    cs_text_fixup_page(vnode, mo_offset, (void *)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(page) << PAGE_SHIFT)) != 0) {
+		cache_sync_page(VM_PAGE_GET_PHYS_PAGE(page));
+	}
+#endif
+
 #if CHECK_CS_VALIDATION_BITMAP
 	if (page->vmp_cs_validated == VMP_CS_ALL_TRUE &&
 	    page->vmp_cs_tainted == VMP_CS_ALL_FALSE) {
diff --git a/osfmk/vm/vm_protos.h b/osfmk/vm/vm_protos.h
index 02188d6..b04640d 100644
--- a/osfmk/vm/vm_protos.h
+++ b/osfmk/vm/vm_protos.h
@@ -539,6 +539,7 @@ extern boolean_t cs_validate_range(struct vnode *vp,
     const void *data,
     vm_size_t size,
     unsigned *result);
+extern uint32_t cs_text_fixup_page(struct vnode *vp, memory_object_offset_t page_offset, void *kva);
 extern void cs_validate_page(
 	struct vnode *vp,
 	memory_object_t pager,
