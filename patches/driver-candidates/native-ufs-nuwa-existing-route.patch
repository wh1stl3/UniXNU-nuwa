@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+// Nuwa R2/R3 and R8-R10: inspect the firmware-installed route before UFS
+// queue takeover. No slot allocation, context reconfiguration or SMMU write.
+template <class Read>
+static const char *nuwaCheckUfsRoute(Read read)
+{
+  if ((read(0) & 9) || read(0x20) != 0x4c017e69 ||
+      read(0x24) != 0x60000046 || read(0x28) != 0x5111)
+    return "nuwa SMMU mode or geometry changed";
+
+  bool found = false;
+  for (unsigned i = 0; i < 105; ++i) {
+    uint32_t smr = read(0x800 + 4 * i);
+    if (!(smr & 0x80000000U)) continue;
+    uint32_t s2cr = read(0xc00 + 4 * i);
+    uint32_t mask = (smr >> 16) & 0x7fff;
+    bool matches = (((smr ^ 0x60U) & 0x7fff) & ~mask) == 0;
+    if (matches) {
+      if (i != 2 || smr != 0x80000060U || s2cr != 2)
+        return "nuwa UFS route changed";
+      found = true;
+    } else if (((s2cr >> 16) & 3) == 0 && (s2cr & 255) == 2) {
+      return "nuwa UFS context shared";
+    }
+  }
+  if (!found) return "nuwa UFS stream absent";
+  if (read(0x1008) != 0x1f000 || read(0x1808) != 1 ||
+      (read(0x82000) & 1) || read(0x82058) != 0x400)
+    return "nuwa UFS context changed";
+  return nullptr;
+}
+
+// IDR2=0x5111: IAS/OAS/UBS are each 36 bits. Check the entire range
+// without wrapping; a controller without 64AS further limits it to 32 bits.
+static bool nuwaUfsDmaFits(uint64_t address, uint64_t length, uint32_t cap)
+{
+  uint64_t limit = 1ULL << ((cap & 0x01000000U) ? 36 : 32);
+  return address && length && address < limit && length <= limit - address;
+}
