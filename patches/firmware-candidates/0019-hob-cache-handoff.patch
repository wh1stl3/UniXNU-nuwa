+// NUWA_HOB_CACHE_BEGIN: only the owned active HOB extent, never the whole Heap.
+STATIC BOOLEAN
+NuwaHobCacheExtent (UINTN Base, UINTN Limit, UINTN UsedEnd, UINTN Line, UINTN *Span)
+{
+  UINTN Rounded;
+  if (Span == NULL) { return FALSE; }
+  *Span = 0;
+  if ((Base == 0) || (Limit <= Base) || (UsedEnd <= Base) || (UsedEnd > Limit) ||
+      (Line < 16) || (Line > 4096) || ((Line & (Line - 1)) != 0) ||
+      ((Base & (Line - 1)) != 0) || (UsedEnd > MAX_UINTN - (Line - 1))) { return FALSE; }
+  Rounded = (UsedEnd + Line - 1) & ~(Line - 1);
+  if (Rounded > Limit) { return FALSE; }
+  *Span = Rounded - Base;
+  return TRUE;
+}
+
+EFI_STATUS EFIAPI NuwaHobCacheHandoff (VOID);
+
+EFI_STATUS EFIAPI
+NuwaHobCacheHandoff (VOID)
+{
+  UINTN El;
+  UINTN Sctlr;
+  UINTN Line;
+  UINTN Span;
+  El = ArmReadCurrentEL ();
+  if ((El != AARCH64_EL1) && (El != AARCH64_EL2)) {
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-CACHE] unsupported el=0x%lx\n", (UINT64)El));
+    CpuDeadLoop ();
+    return EFI_UNSUPPORTED;
+  }
+  Sctlr = ArmReadSctlr ();
+  if ((mNuwaAuditBase == 0) || ((Sctlr & 5) != 0)) {
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-CACHE] refused el=%lu sctlr=0x%lx arena=0x%lx\n",
+            (UINT64)(El >> 2), (UINT64)Sctlr, (UINT64)mNuwaAuditBase));
+    CpuDeadLoop ();
+    return EFI_UNSUPPORTED;
+  }
+  NuwaHobAuditCheckpoint ("cache-handoff-before", 0, TRUE);
+  Line = ArmDataCacheLineLength ();
+  if (!NuwaHobCacheExtent (mNuwaAuditBase, mNuwaAuditLimit, mNuwaLastEnd + 8, Line, &Span)) {
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-CACHE] rejected extent base=0x%lx end=0x%lx line=%lu\n",
+            (UINT64)mNuwaAuditBase, (UINT64)mNuwaLastEnd, (UINT64)Line));
+    CpuDeadLoop ();
+    return EFI_COMPROMISED_DATA;
+  }
+  DEBUG ((EFI_D_ERROR, "[NUWA-HOB-CACHE] invalidate el=%lu sctlr=0x%lx base=0x%lx bytes=0x%lx line=%lu\n",
+          (UINT64)(El >> 2), (UINT64)Sctlr, (UINT64)mNuwaAuditBase, (UINT64)Span, (UINT64)Line));
+  // Uncached writes must complete before DC IVAC; never clean stale HOB lines.
+  // The pinned InvalidateDataCacheRange performs IVAC per aligned line then DSB SY.
+  ArmDataSynchronizationBarrier ();
+  InvalidateDataCacheRange ((VOID *)mNuwaAuditBase, Span);
+  ArmDataSynchronizationBarrier ();
+  ArmInstructionSynchronizationBarrier ();
+  // No HOB writes, allocations or logging between maintenance and MMU installation.
+  return EFI_SUCCESS;
+}
+// NUWA_HOB_CACHE_END
