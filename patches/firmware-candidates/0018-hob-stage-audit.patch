+
+VOID EFIAPI
+NuwaHobAuditCheckpoint (CONST CHAR8 *Phase, UINTN Context, BOOLEAN Announce)
+{
+  EFI_HOB_HANDOFF_INFO_TABLE *Phit;
+  NUWA_HOB_AUDIT_SCAN Scan;
+  UINTN End;
+  UINTN Bytes;
+  UINTN Raw;
+  UINTN Index;
+  UINT32 Reason;
+  if (mNuwaAuditBase == 0) { return; } // Other PrePi consumers never enable this diagnostic.
+  Phit = (VOID *)mNuwaAuditBase;
+  End = (UINTN)Phit->EfiEndOfHobList;
+  ZeroMem (&Scan, sizeof (Scan));
+  Reason = 6;
+  Bytes = 0;
+  if ((GetHobList () == Phit) && (Phit->Header.HobType == EFI_HOB_TYPE_HANDOFF) &&
+      (Phit->Header.HobLength == sizeof (*Phit)) &&
+      (Phit->EfiMemoryBottom == mNuwaAuditBase) && (Phit->EfiMemoryTop == mNuwaAuditLimit) &&
+      (End >= mNuwaAuditBase + sizeof (*Phit)) && (End <= mNuwaAuditLimit - 8) &&
+      (Phit->EfiFreeMemoryBottom == End + 8) &&
+      (Phit->EfiFreeMemoryTop >= Phit->EfiFreeMemoryBottom) &&
+      (Phit->EfiFreeMemoryTop <= mNuwaAuditLimit)) {
+    Bytes = End - mNuwaAuditBase + 8;
+    Reason = NuwaAuditHobBuffer (Phit, Bytes, End - mNuwaAuditBase, &Scan);
+  }
+  if (Reason != 0) {
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-STAGE] bad phase=%a context=0x%lx reason=%u off=0x%lx type=%x len=%x\n",
+            Phase, (UINT64)Context, Reason, (UINT64)Scan.Offset, Scan.Type, Scan.Length));
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-STAGE] last-good phase=%a context=0x%lx count=%u end=0x%lx hash=%x\n",
+            mNuwaLastPhase == NULL ? "none" : mNuwaLastPhase, (UINT64)mNuwaLastContext,
+            (UINT32)mNuwaLastCount, (UINT64)mNuwaLastEnd, mNuwaLastHash));
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-STAGE] phit list=0x%lx end=0x%lx bottom=0x%lx top=0x%lx\n",
+            (UINT64)mNuwaAuditBase, (UINT64)End, Phit->EfiFreeMemoryBottom, Phit->EfiFreeMemoryTop));
+    if ((Bytes >= 8) && (Bytes <= 1048584) && (Scan.Offset <= Bytes - 8)) {
+      Raw = mNuwaAuditBase + Scan.Offset;
+      for (Index = 0; (Index < 4) && (Bytes - Scan.Offset >= (Index + 1) * 8); Index++) {
+        DEBUG ((EFI_D_ERROR, "[NUWA-HOB-STAGE] raw off=0x%lx qword=0x%lx\n",
+                (UINT64)(Scan.Offset + Index * 8), ReadUnaligned64 ((CONST UINT64 *)(Raw + Index * 8))));
+      }
+    }
+    CpuDeadLoop (); // Preserve fail-closed behavior; never repair or skip a HOB.
+    return;
+  }
+  if (Announce) {
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-STAGE] ok phase=%a context=0x%lx count=%u end=0x%lx hash=%x\n",
+            Phase, (UINT64)Context, (UINT32)Scan.Count, (UINT64)End, Scan.Hash));
+  }
+  mNuwaLastPhase = Phase;
+  mNuwaLastContext = Context;
+  mNuwaLastEnd = End;
+  mNuwaLastCount = Scan.Count;
+  mNuwaLastHash = Scan.Hash;
+}
+
+VOID EFIAPI
+NuwaHobAuditInit (VOID *Base, UINTN Length)
+{
+  if ((Base == NULL) || (((UINTN)Base & 7) != 0) ||
+      (Length < sizeof (EFI_HOB_HANDOFF_INFO_TABLE) + 8) ||
+      ((UINTN)Base > MAX_UINTN - Length)) {
+    DEBUG ((EFI_D_ERROR, "[NUWA-HOB-STAGE] invalid trusted arena\n"));
+    CpuDeadLoop ();
+    return;
+  }
+  mNuwaAuditBase = (UINTN)Base;
+  mNuwaAuditLimit = (UINTN)Base + Length;
+  NuwaHobAuditCheckpoint ("hob-constructor", 0, TRUE);
+}
