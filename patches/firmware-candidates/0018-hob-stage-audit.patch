+// NUWA_HOB_AUDIT_PURE_BEGIN: bounded header scan, no allocation or logging.
+typedef struct {
+  UINTN Offset;
+  UINTN Count;
+  UINT16 Type;
+  UINT16 Length;
+  UINT32 Hash;
+} NUWA_HOB_AUDIT_SCAN;
+
+STATIC UINT32
+NuwaAuditHobBuffer (CONST VOID *Buffer, UINTN Bytes, UINTN End, NUWA_HOB_AUDIT_SCAN *Scan)
+{
+  CONST UINT8 *Data;
+  CONST EFI_HOB_GENERIC_HEADER *Header;
+  UINTN At;
+  UINTN Index;
+  if (Scan == NULL) { return 1; }
+  ZeroMem (Scan, sizeof (*Scan));
+  Scan->Hash = 2166136261U;
+  if ((Buffer == NULL) || (((UINTN)Buffer & 7) != 0) || (End > 1048576) ||
+      ((End & 7) != 0) || (Bytes < sizeof (EFI_HOB_GENERIC_HEADER)) ||
+      (End > Bytes - sizeof (EFI_HOB_GENERIC_HEADER))) { return 1; }
+  Data = Buffer;
+  At = 0;
+  for (;;) {
+    Scan->Offset = At;
+    if (Scan->Count == 4096) { return 5; }
+    Header = (CONST EFI_HOB_GENERIC_HEADER *)(Data + At);
+    Scan->Type = Header->HobType;
+    Scan->Length = Header->HobLength;
+    for (Index = 0; Index < sizeof (*Header); Index++) {
+      Scan->Hash = (Scan->Hash ^ Data[At + Index]) * 16777619U;
+    }
+    if (At == End) {
+      return ((Header->HobType == EFI_HOB_TYPE_END_OF_HOB_LIST) &&
+              (Header->HobLength == sizeof (*Header))) ? 0 : 4;
+    }
+    if (Header->HobType == EFI_HOB_TYPE_END_OF_HOB_LIST) { return 4; }
+    if ((Header->HobLength < sizeof (*Header)) || ((Header->HobLength & 7) != 0)) { return 2; }
+    if (Header->HobLength > End - At) { return 3; }
+    At += Header->HobLength;
+    Scan->Count++;
+  }
+}
+// NUWA_HOB_AUDIT_PURE_END
+
+STATIC UINTN mNuwaAuditBase;
+STATIC UINTN mNuwaAuditLimit;
+STATIC CONST CHAR8 *mNuwaLastPhase;
+STATIC UINTN mNuwaLastContext;
+STATIC UINTN mNuwaLastEnd;
