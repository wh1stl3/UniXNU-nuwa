+def toolchain_path():
+    """PATH with the Homebrew LLVM and LLD first, as the archive builders expect."""
+    extra = [d for d in ('/opt/homebrew/opt/llvm/bin', '/opt/homebrew/opt/lld/bin', '/usr/local/opt/llvm/bin', '/usr/local/opt/lld/bin')
